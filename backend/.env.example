# Environment Configuration for WorshipFlow Backend
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3002

# Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=worshipflow
DB_USER=root
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
